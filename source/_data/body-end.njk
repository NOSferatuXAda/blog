<div class="surreal-gyre-bg" aria-hidden="true">
<svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice">
<defs>
<g id="gyreBgKrill">
<path d="M -8 0 Q -3 -3 4 -2.5 L 9 0 L 4 2.5 Q -3 3 -8 0 Z" class="gyre-krill-body"/>
<path d="M -3 -2.6 L -3 2.6 M 0 -2.9 L 0 2.9 M 3 -2.7 L 3 2.7 M 6 -2 L 6 2" class="gyre-krill-segment"/>
<circle cx="-7" cy="-1" r="1.3" class="gyre-krill-eye"/>
<path d="M -8 -1 Q -14 -5 -19 -3" class="gyre-krill-antenna"/>
<path d="M -8 0 Q -12 -2 -16 -0.5" class="gyre-krill-antenna"/>
<path d="M 9 0 L 14 -3.5 L 13.5 0 L 14 3.5 Z" class="gyre-krill-tail"/>
<path d="M -1 2.9 L -2 4.4 M 2 2.8 L 1.5 4.4 M 5 2.1 L 5 3.8" class="gyre-krill-leg"/>
</g>
<line id="gyreBgSpeedline" x1="425" y1="228" x2="425" y2="252" class="gyre-speedline"/>
</defs>

<text x="240" y="44" text-anchor="middle" class="gyre-bleed">Ⅰ</text>
<text x="446" y="248" text-anchor="middle" class="gyre-bleed">Ⅱ</text>
<text x="240" y="458" text-anchor="middle" class="gyre-bleed">Ⅲ</text>
<text x="34" y="248" text-anchor="middle" class="gyre-bleed">Ⅳ</text>

<circle cx="240" cy="240" r="206" class="gyre-ring-warm"/>
<circle cx="240" cy="240" r="150" class="gyre-arc gyre-arc--1"/>
<circle cx="240" cy="240" r="110" class="gyre-ring-cold"/>

<g>
<animateTransform attributeName="transform" type="rotate" from="360 240 240" to="0 240 240" dur="60s" repeatCount="indefinite"/>
<circle cx="240" cy="240" r="178" class="gyre-belt-dash gyre-belt-dash--warm"/>
</g>

<use href="#gyreBgSpeedline" transform="rotate(0 240 240)"/>
<use href="#gyreBgSpeedline" transform="rotate(90 240 240)"/>
<use href="#gyreBgSpeedline" transform="rotate(180 240 240)"/>
<use href="#gyreBgSpeedline" transform="rotate(270 240 240)"/>

<g class="gyre-krill">
<animateTransform attributeName="transform" type="rotate" from="0 240 240" to="360 240 240" dur="55s" repeatCount="indefinite"/>
<g transform="translate(390 240) rotate(90)"><use href="#gyreBgKrill"/></g>
</g>
<g class="gyre-krill">
<animateTransform attributeName="transform" type="rotate" from="360 240 240" to="0 240 240" dur="75s" repeatCount="indefinite"/>
<g transform="translate(114 240) rotate(-90)"><use href="#gyreBgKrill"/></g>
</g>

<g><animateTransform attributeName="transform" type="rotate" from="0 240 240" to="360 240 240" dur="26s" repeatCount="indefinite"/><circle cx="430" cy="200" r="2.5" class="gyre-particle"/></g>
<g><animateTransform attributeName="transform" type="rotate" from="360 240 240" to="0 240 240" dur="38s" repeatCount="indefinite"/><circle cx="200" cy="60" r="2" class="gyre-particle"/></g>
<g><animateTransform attributeName="transform" type="rotate" from="0 240 240" to="360 240 240" dur="32s" repeatCount="indefinite"/><circle cx="80" cy="360" r="2" class="gyre-particle"/></g>
<g><animateTransform attributeName="transform" type="rotate" from="360 240 240" to="0 240 240" dur="44s" repeatCount="indefinite"/><circle cx="360" cy="420" r="2" class="gyre-particle"/></g>
</svg>
</div>

<script src="{{ config.root }}js/waves-bg.js" defer></script>

<div class="surreal-announcement" id="surreal-announcement" role="dialog" aria-modal="true" aria-labelledby="surreal-announcement-title" hidden>
  <div class="surreal-announcement__backdrop" data-close="overlay"></div>
  <div class="surreal-announcement__frame">
    <div class="surreal-announcement__panel">
      <button type="button" class="surreal-announcement__close" data-close="button" aria-label="关闭公告">×</button>
      <p class="surreal-announcement__kicker">最新公告</p>
      <h2 class="surreal-announcement__title" id="surreal-announcement-title"></h2>
      <p class="surreal-announcement__date"></p>
      <div class="surreal-announcement__body"></div>
      <div class="surreal-announcement__actions">
        <button type="button" class="surreal-announcement__dismiss" data-dismiss>不再提醒</button>
        <a class="surreal-announcement__more" href="{{ config.root }}logs/">查看全部公告 →</a>
      </div>
    </div>
  </div>
</div>
<script>
  window.__SURREAL_ANNOUNCEMENT__ = {
    jsonUrl: "{{ config.root }}logs.json",
    pageUrl: "{{ config.root }}logs/"
  };
</script>
<script src="{{ config.root }}js/announcement-popup.js" defer></script>


<script src="{{ config.root }}js/portfolio-filter.js" defer></script>
<script src="{{ config.root }}js/article-toc.js" defer></script>

