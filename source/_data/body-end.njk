
{% if page.title === '首页' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice"><path d="M -10 90 Q 120 70 240 90 T 490 90" class="gyre-current-line"/><path d="M -10 200 Q 120 220 240 200 T 490 200" class="gyre-current-line"/><circle cx="90" cy="90" r="2" class="gyre-particle"/><circle cx="330" cy="200" r="1.6" class="gyre-particle"/><circle cx="180" cy="260" r="1.4" class="gyre-particle"/></svg></div>
{% elif page.title === '作品集' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice"><circle cx="140" cy="90" r="2" class="gyre-particle"/><circle cx="320" cy="200" r="1.6" class="gyre-particle"/><circle cx="90" cy="340" r="1.4" class="gyre-particle"/><circle cx="380" cy="120" r="1.2" class="gyre-particle"/><circle cx="240" cy="430" r="1.8" class="gyre-particle"/></svg></div>
{% elif page.title === '分类' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice"><path d="M 40 40 L 240 240" class="gyre-current-line"/><path d="M 440 40 L 240 240" class="gyre-current-line"/><path d="M 40 440 L 240 240" class="gyre-current-line"/><path d="M 440 440 L 240 240" class="gyre-current-line"/><circle cx="240" cy="240" r="3" class="gyre-particle"/></svg></div>
{% elif page.title === '关于' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice"><circle cx="240" cy="240" r="150" class="gyre-arc gyre-arc--1"/><g transform="translate(340 180) rotate(35)"><path d="M -8 0 Q -3 -3 4 -2.5 L 9 0 L 4 2.5 Q -3 3 -8 0 Z" class="gyre-krill-body"/><path d="M -3 -2.6 L -3 2.6 M 0 -2.9 L 0 2.9 M 3 -2.7 L 3 2.7 M 6 -2 L 6 2" class="gyre-krill-segment"/><circle cx="-7" cy="-1" r="1.3" class="gyre-krill-eye"/><path d="M -8 -1 Q -14 -5 -19 -3" class="gyre-krill-antenna"/><path d="M -8 0 Q -12 -2 -16 -0.5" class="gyre-krill-antenna"/><path d="M 9 0 L 14 -3.5 L 13.5 0 L 14 3.5 Z" class="gyre-krill-tail"/><path d="M -1 2.9 L -2 4.4 M 2 2.8 L 1.5 4.4 M 5 2.1 L 5 3.8" class="gyre-krill-leg"/></g></svg></div>
{% elif page.title === '公告' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice"><path d="M 240 0 L 240 480" class="gyre-current-line"/><circle cx="240" cy="90" r="2" class="gyre-particle"/><circle cx="240" cy="230" r="1.6" class="gyre-particle"/><circle cx="240" cy="390" r="1.4" class="gyre-particle"/></svg></div>
{% elif page.title === '致谢' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice"><circle cx="120" cy="400" r="2.2" class="gyre-particle"/><circle cx="240" cy="300" r="1.8" class="gyre-particle"/><circle cx="360" cy="180" r="1.5" class="gyre-particle"/><circle cx="200" cy="80" r="1.2" class="gyre-particle"/></svg></div>
{% elif page.title === '站务记录' %}
<div class="surreal-current" aria-hidden="true"><svg viewBox="0 0 480 480" preserveAspectRatio="xMidYMid slice"><path d="M 80 120 L 140 120" class="gyre-current-line"/><path d="M 320 220 L 400 220" class="gyre-current-line"/><path d="M 140 360 L 200 360" class="gyre-current-line"/><path d="M 360 420 L 420 420" class="gyre-current-line"/></svg></div>
{% endif %}
<script src="{{ config.root }}js/waves-bg.js" defer></script>

<div class="surreal-announcement" id="surreal-announcement" role="dialog" aria-modal="true" aria-labelledby="surreal-announcement-title" hidden>
  <div class="surreal-announcement__backdrop" data-close="overlay"></div>
  <div class="surreal-announcement__frame">
    <div class="surreal-announcement__panel">
      <button type="button" class="surreal-announcement__close" data-close="button" aria-label="关闭公告">×</button>
      <p class="surreal-announcement__kicker">最新公告</p>
      <h2 class="surreal-announcement__title" id="surreal-announcement-title"></h2>
      <p class="surreal-announcement__date"></p>
      <div class="surreal-announcement__body"></div>
      <div class="surreal-announcement__actions">
        <button type="button" class="surreal-announcement__dismiss" data-dismiss>不再提醒</button>
        <a class="surreal-announcement__more" href="{{ config.root }}logs/">查看全部公告 →</a>
      </div>
    </div>
  </div>
</div>
<script>
  window.__SURREAL_ANNOUNCEMENT__ = {
    jsonUrl: "{{ config.root }}logs.json",
    pageUrl: "{{ config.root }}logs/"
  };
</script>
<script src="{{ config.root }}js/announcement-popup.js" defer></script>


<script src="{{ config.root }}js/portfolio-filter.js" defer></script>
<script src="{{ config.root }}js/article-toc.js" defer></script>

